dist/
web-build/
expo-env.d.ts
.expo/
*.tsbuildinfo

# Native projects generated by Expo prebuild (CNG). Rebuild with `npx expo prebuild`.
/android
/ios

# Environment: never commit real configuration or secrets
.env
.env.*
!.env.example

