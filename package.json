{
  "name": "rodakawan",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run deps:check && npm run db:test:lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:scripts": "node --test --test-concurrency=1 --test-timeout=180000 \"scripts/__tests__/*.test.mjs\"",
    "deps:check": "node scripts/check-editor-ts.mjs && node scripts/check-expo-deps.mjs",
    "check:editor-ts": "node scripts/check-editor-ts.mjs",
    "db:test": "node --env-file-if-exists=.env.db scripts/db-test.mjs",
    "db:test:concurrency": "node --env-file-if-exists=.env.db scripts/db-write-throttle-concurrency.mjs",
    "db:test:lint": "node scripts/check-test-uuid-literals.mjs",
    "storage:test": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.db scripts/storage-test.mjs",
    "e2e:account-delete": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.db scripts/account-deletion-e2e.mjs",
    "e2e:shared-ride": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.db scripts/shared-ride-e2e.mjs",
    "beta:preflight": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.db scripts/beta-preflight.mjs",
    "db:types": "node --env-file-if-exists=.env.db scripts/db-types.mjs",
    "db:types:check": "node --env-file-if-exists=.env.db scripts/db-types.mjs --check",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android",
    "assets:generate": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-doctor": "1.21.5",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "node-forge": "1.4.1"
  }
}
