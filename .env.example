# RodaKawan — contoh konfigurasi lingkungan.
#
# Cara pakai: salin file ini menjadi `.env.local` lalu isi nilai sebenarnya.
# `.env.local` sudah diabaikan Git; jangan pernah commit nilai asli.
#
# PENTING: hanya variabel berprefix `EXPO_PUBLIC_` yang dikirim ke bundle aplikasi,
# sehingga nilainya harus aman untuk publik. JANGAN menaruh service role key Supabase,
# database password, LiveKit secret, signing key, atau token admin di file ini —
# rahasia tersebut hanya boleh berada di environment server/Edge Functions.

# --- Supabase (backend awal, ADR-004) ---
# Diisi setelah project development Supabase dibuat (docs/SETUP_GUIDE.md).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_CLIENT_KEY

# --- Peta / tiles (ADR-009: provider dipilih setelah uji biaya & lisensi) ---
EXPO_PUBLIC_MAP_STYLE_URL=https://YOUR_TILE_PROVIDER/STYLE.json
