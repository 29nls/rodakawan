{
  "expo": {
    "name": "RodaKawan",
    "slug": "rodakawan",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rodakawan",
    "userInterfaceStyle": "dark",
    "platforms": ["android", "ios"],
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B0D10",
    "android": {
      "package": "com.rodakawan.app",
      "versionCode": 1,
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D10"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "image": "./assets/splash-icon.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0D10",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "RodaKawan memakai foto dari galeri hanya untuk foto kendaraan dan logo klub yang Anda pilih sendiri.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RodaKawan memakai lokasi Anda hanya saat Anda menyalakan berbagi posisi di perjalanan aktif.",
          "locationAlwaysAndWhenInUsePermission": "RodaKawan tetap mengirim posisi selama perjalanan aktif bila Anda memilih berbagi di latar belakang. Anda dapat menghentikannya kapan saja.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bded94f5-467b-4852-9daa-f8beecb04b82"
      }
    },
    "owner": "maceeng"
  }
}
