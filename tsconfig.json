{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    // Hanya tipe Jest yang disertakan; tipe Node tidak dipakai di runtime React Native.
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Edge Function berjalan di Deno (global `Deno`, impor npm:/URL); tipe-nya
  // diperiksa terpisah dengan `deno check`, bukan `tsc` aplikasi React Native.
  "exclude": ["node_modules", "dist", ".expo", "supabase/functions"]
}
